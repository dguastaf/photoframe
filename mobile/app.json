{
  "expo": {
    "name": "Photoframe",
    "slug": "photoframe",
    "version": "1.0.0",
    "scheme": "photoframe",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dguastaf.photoframe"
    },
    "android": {
      "package": "com.dguastaf.photoframe",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9c7ad4c8-177f-4665-927b-72e5f9a13f82"
    },
    "extra": {
      "eas": {
        "projectId": "9c7ad4c8-177f-4665-927b-72e5f9a13f82"
      }
    },
    "owner": "dguastaf",
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-updates"
    ]
  }
}
